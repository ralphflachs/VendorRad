<Window x:Class="VendorRad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VendorRad"
        Title="VendorRad - Contact Management System" Height="600" Width="800">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <!-- Define UI Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="VendorRad - Contact Management System" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,20"/>

        <!-- Tab Control for Customer and Vendor contacts -->
        <TabControl Grid.Row="1" Grid.ColumnSpan="1">
            <TabItem Header="Customer">
                <StackPanel Margin="10">
                    <Label Content="Name:"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Company:"/>
                    <TextBox Text="{Binding CustomerCompany, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Phone Number:"/>
                    <TextBox Text="{Binding CustomerPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Address:"/>
                    <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Sales Notes:"/>
                    <TextBox Text="{Binding CustomerSalesNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap"/>
                    <Button Content="Save Customer" Width="120" Margin="10,10,0,0" Command="{Binding SaveCustomerCommand}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Vendor">
                <StackPanel Margin="10">
                    <Label Content="Name:"/>
                    <TextBox Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Company:"/>
                    <ComboBox SelectedItem="{Binding SelectedMasterVendor}" DisplayMemberPath="CompanyName" ItemsSource="{Binding MasterVendors}" />
                    <Label Content="Phone Number:"/>
                    <TextBox Text="{Binding VendorPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Address:"/>
                    <TextBox Text="{Binding VendorAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Save Vendor" Width="120" Margin="10,10,0,0" Command="{Binding SaveVendorCommand}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Clock Display -->
        <StackPanel Grid.Row="0"  Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
            <TextBlock Text="Current Time:" FontSize="16"/>
            <TextBlock Text="{Binding CurrentTime}" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Contact List Display -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="1" Header="Contacts" Margin="10,10,10,10">
            <ListView Name="ContactListView" ItemsSource="{Binding Contacts}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="100"/>
                        <GridViewColumn Header="Company" DisplayMemberBinding="{Binding Company}" Width="100"/>
                        <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding PhoneNumber}" Width="100"/>
                        <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="100"/>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding ContactType}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Master Vendor Add Section -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Vendor Company" Width="150" Margin="10,0,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Label Content="Company Name:"/>
                <TextBox Text="{Binding NewMasterVendorCompanyName, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Vendor Code:"/>
                <TextBox Text="{Binding NewMasterVendorCode, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Add Company" Command="{Binding AddMasterVendorCommand}" Margin="0,20,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Master Vendor List Display -->
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Vendor Companies" Margin="10,10,10,10">
            <ListView ItemsSource="{Binding MasterVendors}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Company Name" DisplayMemberBinding="{Binding CompanyName}" Width="100"/>
                        <GridViewColumn Header="Vendor Code" DisplayMemberBinding="{Binding VendorCode}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</Window>
